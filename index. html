     EVERYTHING IS EMBEDDED HERE
     NO firebase.js FILE IS REQUIRED
     ========================================================= -->

<script type="module">

    /* ========================================================
       FIREBASE IMPORTS
       ======================================================== */

    import {
        initializeApp
    } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";


    import {
        getDatabase,
        ref,
        push,
        set,
        update
    } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";


    import {
        getStorage,
        ref as storageRef,
        uploadBytes,
        getDownloadURL
    } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-storage.js";


    /* ========================================================
       FIREBASE CONFIG
       ======================================================== */

    const firebaseConfig = {

        apiKey: "AIzaSyDtyALfdSivLzw5rpiD70InIct-ZawcMU",

        authDomain:
            "ooaks-5d887.firebaseapp.com",

        projectId:
            "ooaks-5d887",

        storageBucket:
            "ooaks-5d887.firebasestorage.app",

        messagingSenderId:
            "76992379291",

        appId:
            "1:76992379291:web:5694e67da538556b76493e",

        measurementId:
            "G-6B8GKDTW01",

        databaseURL:
            "https://ooaks-5d887-default-rtdb.firebaseio.com"

    };


    /* ========================================================
       INITIALIZE
       ======================================================== */

    const app =
        initializeApp(firebaseConfig);


    const database =
        getDatabase(app);


    const storage =
        getStorage(app);


    console.log(
        "Firebase initialized successfully."
    );


    /* ========================================================
       FORM ELEMENTS
       ======================================================== */

    const form =
        document.getElementById(
            "ooak-application-form"
        );


    const submitBtn =
        document.getElementById(
            "submit-btn"
        );


    const statusMessage =
        document.getElementById(
            "status-message"
        );


    const fileInput =
        document.getElementById(
            "booth-file-input"
        );


    const dropZone =
        document.getElementById(
            "file-drop-zone"
        );


    const browseLink =
        document.getElementById(
            "browse-link"
        );


    const fileNameDisplay =
        document.getElementById(
            "file-name-display"
        );


    const canvas =
        document.getElementById(
            "signature-pad"
        );


    const clearSignature =
        document.getElementById(
            "clear-signature"
        );


    let ctx =
        canvas.getContext("2d");


    let signatureDrawn =
        false;


    /* ========================================================
       STATUS
       ======================================================== */

    function setStatus(
        message,
        isError = false
    ) {

        statusMessage.style.display =
            "block";

        statusMessage.textContent =
            message;

        statusMessage.style.color =
            isError
                ? "#b00020"
                : "#333";
    }


    /* ========================================================
       TIMEOUT HELPER
       ======================================================== */

    function withTimeout(
        promise,
        milliseconds,
        errorMessage
    ) {

        return Promise.race([

            promise,

            new Promise(
                function(resolve, reject) {

                    setTimeout(
                        function() {

                            reject(
                                new Error(
                                    errorMessage
                                )
                            );

                        },
                        milliseconds
                    );

                }
            )

        ]);

    }


    /* ========================================================
       FILE SELECTION
       ======================================================== */

    dropZone.addEventListener(
        "click",
        function() {

            fileInput.click();

        }
    );


    browseLink.addEventListener(
        "click",
        function(event) {

            event.preventDefault();

            event.stopPropagation();

            fileInput.click();

        }
    );


    fileInput.addEventListener(
        "change",
        function() {

            if (
                !this.files ||
                !this.files.length
            ) {

                return;

            }


            const file =
                this.files[0];


            if (
                file.size >
                15 * 1024 * 1024
            ) {

                alert(
                    "The selected file is larger than 15 MB."
                );

                this.value = "";

                fileNameDisplay.textContent =
                    "";

                return;

            }


            fileNameDisplay.textContent =
                "Selected file: " +
                file.name;

        }
    );


    /* ========================================================
       DRAG AND DROP
       ======================================================== */

    dropZone.addEventListener(
        "dragover",
        function(event) {

            event.preventDefault();

            dropZone.style.borderColor =
                "#0066cc";

            dropZone.style.background =
                "#f0f7ff";

        }
    );


    dropZone.addEventListener(
        "dragleave",
        function() {

            dropZone.style.borderColor =
                "#aaa";

            dropZone.style.background =
                "#f9f9f9";

        }
    );


    dropZone.addEventListener(
        "drop",
        function(event) {

            event.preventDefault();

            dropZone.style.borderColor =
                "#aaa";

            dropZone.style.background =
                "#f9f9f9";


            const files =
                event.dataTransfer.files;


            if (
                !files ||
                !files.length
            ) {

                return;

            }


            const file =
                files[0];


            if (
                file.size >
                15 * 1024 * 1024
            ) {

                alert(
                    "The selected file is larger than 15 MB."
                );

                return;

            }


            try {

                const dataTransfer =
                    new DataTransfer();

                dataTransfer.items.add(file);

                fileInput.files =
                    dataTransfer.files;

            } catch (error) {

                console.error(
                    "Could not attach dropped file:",
                    error
                );

            }


            fileNameDisplay.textContent =
                "Selected file: " +
                file.name;

        }
    );


    /* ========================================================
       SIGNATURE PAD
       ======================================================== */

    function setupCanvas() {

        const rect =
            canvas.getBoundingClientRect();


        const ratio =
            Math.max(
                window.devicePixelRatio || 1,
                1
            );


        canvas.width =
            Math.floor(
                rect.width * ratio
            );


        canvas.height =
            Math.floor(
                rect.height * ratio
            );


        ctx =
            canvas.getContext("2d");


        ctx.setTransform(
            ratio,
            0,
            0,
            ratio,
            0,
            0
        );


        ctx.lineWidth = 2;

        ctx.lineCap =
            "round";

        ctx.lineJoin =
            "round";

        ctx.strokeStyle =
            "#000000";

    }


    setupCanvas();


    let drawing = false;


    function getPointerPosition(
        event
    ) {

        const rect =
            canvas.getBoundingClientRect();


        return {

            x:
                event.clientX -
                rect.left,

            y:
                event.clientY -
                rect.top

        };

    }


    canvas.addEventListener(
        "pointerdown",
        function(event) {

            event.preventDefault();

            drawing = true;

            signatureDrawn = true;

            canvas.setPointerCapture(
                event.pointerId
            );


            const position =
                getPointerPosition(
                    event
                );


            ctx.beginPath();

            ctx.moveTo(
                position.x,
                position.y
            );

        }
    );


    canvas.addEventListener(
        "pointermove",
        function(event) {

            if (!drawing) {
                return;
            }


            event.preventDefault();


            const position =
                getPointerPosition(
                    event
                );


            ctx.lineTo(
                position.x,
                position.y
            );


            ctx.stroke();

        }
    );


    canvas.addEventListener(
        "pointerup",
        function(event) {

            drawing = false;

            try {

                canvas.releasePointerCapture(
                    event.pointerId
                );

            } catch (error) {}

        }
    );


    canvas.addEventListener(
        "pointercancel",
        function() {

            drawing = false;

        }
    );


    clearSignature.addEventListener(
        "click",
        function() {

            ctx.clearRect(
                0,
                0,
                canvas.width,
                canvas.height
            );


            signatureDrawn =
                false;

        }
    );


    /* ========================================================
       SIGNATURE BLOB
       ======================================================== */

    function getSignatureBlob() {

        return new Promise(
            function(resolve) {

                canvas.toBlob(
                    function(blob) {

                        resolve(blob);

                    },
                    "image/png"
                );

            }
        );

    }


    /* ========================================================
       RADIO VALUE
       ======================================================== */

    function getRadioValue(
        name
    ) {

        const selected =
            document.querySelector(
                'input[name="' +
                name +
                '"]:checked'
            );


        return selected
            ? selected.value
            : "";

    }


    /* ========================================================
       SAVE APPLICATION
       ======================================================== */

    async function saveApplication(
        applicationData
    ) {

        console.log(
            "Saving application to Realtime Database..."
        );


        const applicationsRef =
            ref(
                database,
                "applications"
            );


        const newApplicationRef =
            push(
                applicationsRef
            );


        const applicationId =
            newApplicationRef.key;


        applicationData.applicationId =
            applicationId;


        await withTimeout(

            set(
                newApplicationRef,
                applicationData
            ),

            30000,

            "Saving the application timed out. Please check your Firebase Realtime Database configuration and rules."
        );


        console.log(
            "Application saved:",
            applicationId
        );


        return applicationId;

    }


    /* ========================================================
       UPLOAD FILE
       ======================================================== */

    async function uploadUserFile(
        file,
        path
    ) {

        console.log(
            "Uploading:",
            path
        );


        const fileRef =
            storageRef(
                storage,
                path
            );


        await withTimeout(

            uploadBytes(
                fileRef,
                file
            ),

            30000,

            "File upload timed out. Please check Firebase Storage."
        );


        console.log(
            "File uploaded."
        );


        const downloadURL =
            await withTimeout(

                getDownloadURL(
                    fileRef
                ),

                30000,

                "Getting the uploaded file URL timed out."
            );


        console.log(
            "Download URL obtained."
        );


        return downloadURL;

    }


    /* ========================================================
       UPDATE APPLICATION
       ======================================================== */

    async function updateApplication(
        applicationId,
        data
    ) {

        const applicationRef =
            ref(
                database,
                "applications/" +
                applicationId
            );


        await withTimeout(

            update(
                applicationRef,
                data
            ),

            30000,

            "Updating the application timed out."
        );

    }


    /* ========================================================
       FORM SUBMISSION
       ======================================================== */

    form.addEventListener(
        "submit",
        async function(event) {

            event.preventDefault();


            console.log(
                "========== FORM SUBMISSION STARTED =========="
            );


            /* ------------------------------------------------
               VALIDATION
               ------------------------------------------------ */

            if (
                !form.checkValidity()
            ) {

                form.reportValidity();

                return;

            }


            const email =
                document
                    .getElementById(
                        "email"
                    )
                    .value
                    .trim();


            const confirmEmail =
                document
                    .getElementById(
                        "confirmEmail"
                    )
                    .value
                    .trim();


            if (
                email.toLowerCase() !==
                confirmEmail.toLowerCase()
            ) {

                alert(
                    "The email addresses do not match."
                );

                return;

            }


            if (!signatureDrawn) {

                alert(
                    "Please draw your signature before submitting."
                );

                return;

            }


            /* ------------------------------------------------
               DISABLE BUTTON
               ------------------------------------------------ */

            submitBtn.disabled =
                true;

            submitBtn.textContent =
                "Submitting...";


            try {

                const timestamp =
                    Date.now();


                /* ============================================
                   COLLECT DATA
                   ============================================ */

                const applicationData = {

                    firstName:
                        document
                            .getElementById(
                                "firstName"
                            )
                            .value
                            .trim(),

                    lastName:
                        document
                            .getElementById(
                                "lastName"
                            )
                            .value
                            .trim(),

                    email:
                        email,

                    confirmEmail:
                        confirmEmail,

                    phone:
                        document
                            .getElementById(
                                "phone"
                            )
                            .value
                            .trim(),

                    companyName:
                        document
                            .getElementById(
                                "companyName"
                            )
                            .value
                            .trim(),

                    exhibitingName:
                        document
                            .getElementById(
                                "exhibitingName"
                            )
                            .value
                            .trim(),

                    website:
                        document
                            .getElementById(
                                "website"
                            )
                            .value
                            .trim(),

                    socialMedia:
                        document
                            .getElementById(
                                "socialMedia"
                            )
                            .value
                            .trim(),

                    ontarioMade:
                        getRadioValue(
                            "ontario_made"
                        ),

                    productCategory:
                        document
                            .getElementById(
                                "productCategory"
                            )
                            .value,

                    startYear:
                        document
                            .getElementById(
                                "startYear"
                            )
                            .value
                            .trim(),

                    billingAddress:
                        document
                            .getElementById(
                                "billingAddress"
                            )
                            .value
                            .trim(),

                    billingAddress2:
                        document
                            .getElementById(
                                "billingAddress2"
                            )
                            .value
                            .trim(),

                    city:
                        document
                            .getElementById(
                                "city"
                            )
                            .value
                            .trim(),

                    province:
                        document
                            .getElementById(
                                "province"
                            )
                            .value
                            .trim(),

                    postalCode:
                        document
                            .getElementById(
                                "postalCode"
                            )
                            .value
                            .trim(),

                    choice1:
                        getRadioValue(
                            "choice_1"
                        ),

                    choice2:
                        getRadioValue(
                            "choice_2"
                        ),

                    choice3:
                        getRadioValue(
                            "choice_3"
                        ),

                    unavailableAction:
                        getRadioValue(
                            "unavailable_action"
                        ),

                    accessibility:
                        document
                            .getElementById(
                                "accessibility"
                            )
                            .value
                            .trim(),

                    contactPermission:
                        document
                            .getElementById(
                                "contactPermission"
                            )
                            .checked,

                    attachedFileUrl:
                        "",

                    signatureUrl:
                        "",

                    submittedAt:
                        new Date()
                            .toISOString(),

                    status:
                        "Submitted",

                    event:
                        "One Of A Kind Spring Market 2027",

                    eventDate:
                        "April 1-4, 2027"

                };


                /* ============================================
                   STEP 1
                   SAVE APPLICATION
                   ============================================ */

                setStatus(
                    "Saving application..."
                );


                console.log(
                    "STEP 1: Saving application..."
                );


                const applicationId =
                    await saveApplication(
                        applicationData
                    );


                console.log(
                    "STEP 1 COMPLETE:",
                    applicationId
                );


                /* ============================================
                   STEP 2
                   BOOTH FILE
                   ============================================ */

                let fileUploadFailed =
                    false;


                if (
                    fileInput.files &&
                    fileInput.files.length > 0
                ) {

                    setStatus(
                        "Application saved. Uploading booth display..."
                    );


                    const file =
                        fileInput.files[0];


                    const safeFileName =
                        file.name.replace(
                            /[^a-zA-Z0-9._-]/g,
                            "_"
                        );


                    const filePath =
                        "uploads/" +
                        applicationId +
                        "_" +
                        timestamp +
                        "_" +
                        safeFileName;


                    console.log(
                        "STEP 2: Uploading booth file..."
                    );


                    try {

                        const fileURL =
                            await uploadUserFile(
                                file,
                                filePath
                            );


                        await updateApplication(
                            applicationId,
                            {
                                attachedFileUrl:
                                    fileURL
                            }
                        );


                        console.log(
                            "STEP 2 COMPLETE"
                        );


                    } catch (error) {

                        fileUploadFailed =
                            true;


                        console.error(
                            "BOOTH FILE UPLOAD FAILED:",
                            error
                        );

                    }

                }


                /* ============================================
                   STEP 3
                   SIGNATURE
                   ============================================ */

                setStatus(
                    "Uploading signature..."
                );


                console.log(
                    "STEP 3: Preparing signature..."
                );


                const signatureBlob =
                    await getSignatureBlob();


                let signatureUploadFailed =
                    false;


                if (signatureBlob) {

                    const signaturePath =
                        "signatures/" +
                        applicationId +
                        "_" +
                        timestamp +
                        ".png";


                    try {

                        const signatureURL =
                            await uploadUserFile(
                                signatureBlob,
                                signaturePath
                            );


                        await updateApplication(
                            applicationId,
                            {
                                signatureUrl:
                                    signatureURL
                            }
                        );


                        console.log(
                            "STEP 3 COMPLETE"
                        );


                    } catch (error) {

                        signatureUploadFailed =
                            true;


                        console.error(
                            "SIGNATURE UPLOAD FAILED:",
                            error
                        );

                    }

                }


                /* ============================================
                   FINAL RESULT
                   ============================================ */

                if (
                    fileUploadFailed ||
                    signatureUploadFailed
                ) {

                    setStatus(
                        "Application saved, but one or more attachments could not be uploaded."
                    );


                    alert(
                        "Your application was saved successfully.\n\n" +
                        "Application ID: " +
                        applicationId +
                        "\n\n" +
                        "However, one or more attachments could not be uploaded. Check the browser console for details."
                    );

                } else {

                    setStatus(
                        "Application submitted successfully!"
                    );


                    alert(
                        "Application submitted successfully!\n\n" +
                        "Application ID: " +
                        applicationId
                    );

                }


                /* ============================================
                   RESET FORM
                   ============================================ */

                form.reset();


                fileInput.value =
                    "";


                fileNameDisplay.textContent =
                    "";


                ctx.clearRect(
                    0,
                    0,
                    canvas.width,
                    canvas.height
                );


                signatureDrawn =
                    false;


                /* Checkbox needs to remain checked */

                document
                    .getElementById(
                        "contactPermission"
                    )
                    .checked =
                    true;


                console.log(
                    "========== FORM SUBMISSION FINISHED =========="
                );


            } catch (error) {

                console.error(
                    "========== SUBMISSION ERROR =========="
                );


                console.error(
                    error
                );


                console.error(
                    "ERROR CODE:",
                    error.code
                );


                console.error(
                    "ERROR MESSAGE:",
                    error.message
                );


                setStatus(
                    "Submission failed: " +
                    error.message,
                    true
                );


                alert(
                    "Submission failed.\n\n" +
                    error.message
                );


            } finally {

                submitBtn.disabled =
                    false;

                submitBtn.textContent =
                    "Submit Now";

            }

        }
    );


    /* ========================================================
       SAVE AND RESUME LATER
       ======================================================== */

    const saveLaterBtn =
        document.getElementById(
            "save-later-btn"
        );


    saveLaterBtn.addEventListener(
        "click",
        function() {

            alert(
                "Save and Resume Later is not enabled yet. Please use Submit Now to send the application."
            );

        }
    );


    /* ========================================================
       FIREBASE READY
       ======================================================== */

    console.log(
        "OOAK application form is ready."
    );

</script>

